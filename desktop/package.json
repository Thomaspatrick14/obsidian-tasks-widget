{
  "name": "obsidian-tasks-desktop",
  "productName": "Obsidian Tasks",
  "version": "1.1.0",
  "description": "Desktop widget for an Obsidian markdown to-do note",
  "author": "Thomaspatrick14",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win dir --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.thomaspatrick.obsidiantasks.desktop",
    "productName": "Obsidian Tasks",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ObsidianTasks-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
